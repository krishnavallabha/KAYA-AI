# FlowSense Backend Configuration Example

# FastAPI Configurations
PROJECT_NAME="FlowSense Backend"
API_V1_STR="/api/v1"

# Database Configuration
# Defaults to SQLite locally. For PostgreSQL, configure your connection URL:
# DATABASE_URL="postgresql://user:password@localhost:5432/flowsensedb"
DATABASE_URL="sqlite:///./flowsense.db"

# LLM API Credentials
OPENAI_API_KEY="your-openai-api-key-here"
GROQ_API_KEY="gsk_your_groq_key_here"
